[Unit]
Description=ZapLink DTV Engine
After=network.target

[Service]
Type=simple
User=zaplink
Group=zaplink
SupplementaryGroups=video render
WorkingDirectory=/opt/zaplink
Environment=ZAPLINK_DB_PATH=/var/lib/zaplink/epg.db
Environment=ZAPLINK_CHANNELS_PATH=/var/lib/zaplink/channels.conf
ExecStart=/opt/zaplink/zaplink
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogLevelPrefix=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/zaplink
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0027

[Install]
WantedBy=multi-user.target
